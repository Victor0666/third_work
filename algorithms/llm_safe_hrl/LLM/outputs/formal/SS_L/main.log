            "initial_value": 0.4,
            "lower_bound": 0.0,
            "upper_bound": 1.0,
            "semantic_description": "Normalized uncertainty level above which risk-aware gating activates.",
            "parameter_type": "float",
            "transform": "identity"
        },
        {
            "name": "rank_slack_coupling",
            "initial_value": 0.6,
            "lower_bound": 0.0,
            "upper_bound": 1.0,
            "semantic_description": "Strength of coupling between upward_rank and slack pressure for critical path acceleration.",
            "parameter_type": "float",
            "transform": "identity"
        },
        {
            "name": "remaining_work_weight",
            "initial_value": 0.5,
            "lower_bound": 0.0,
            "upper_bound": 2.0,
            "semantic_description": "Weight for remaining_work term to mildly prefer large downstream work.",
            "parameter_type": "float",
            "transform": "identity"
        },
        {
            "name": "wait_saturation_offset",
            "initial_value": 1e-6,
            "lower_bound": 1e-9,
