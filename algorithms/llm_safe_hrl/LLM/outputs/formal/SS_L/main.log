def get_task_priority_v2(
    min_exec_time,
    min_comm_time,
    min_incremental_energy,
    slack,
    upward_rank,
    remaining_work,
    ready_wait_time,
    uncertainty
):
    """Corrected priority rule with all numeric thresholds declared as parameters."""
    eps = PARAMS["epsilon"]
    
    # Robust normalization: use median absolute deviation (MAD) + epsilon for outlier resilience
    def robust_normalize(x):
        x = np.asarray(x, dtype=float)
        center = np.median(x)
        scale = np.median(np.abs(x - center)) + eps
        return (x - center) / scale
    
    # Normalize base features using robust MAD-based scaling
    norm_slack = robust_normalize(slack)
    norm_energy = robust_normalize(min_incremental_energy)
    norm_rank = robust_normalize(upward_rank)
    norm_work = robust_normalize(remaining_work)
    norm_wait = robust_normalize(ready_wait_time)
    norm_uncert = robust_normalize(uncertainty)
    norm_duration = robust_normalize(min_exec_time + min_comm_time)
    
    # Piecewise slack urgency: strong penalty for negative slack, soft gain near zero
    # Uses declared clip bounds instead of hidden literals
    slack_urgency = (
        PARAMS["slack_risk_penalty"] * np.tanh(np.clip(-norm_slack, 0, PARAMS["slack_clip_upper"]))  # >0 for negative slack
        + PARAMS["slack_urgency_gain"] * np.tanh(np.clip(norm_slack, 0, PARAMS["slack_clip_upper_pos"]))  # >0 for small positive slack
    )
    
    # Sigmoid gate for criticality: attenuate upward rank weight when slack is severely negative
    slack_pressure = np.clip(-norm_slack, 0, PARAMS["slack_clip_upper"])
    rank_gate = 1.0 / (1.0 + np.exp(PARAMS["rank_slack_gate"] * (slack_pressure - 2)))
    criticality_term = PARAMS["criticality_weight"] * rank_gate * norm_rank
    
    # Uncertainty-modulated slack coupling: amplify urgency only when uncertainty is high AND slack is tight
    coupling = np.tanh(PARAMS["uncertainty_slack_coupling"] * norm_uncert * np.clip(-norm_slack, 0, PARAMS["slack_clip_upper"]))
    
    # Duration fairness term: penalizes extreme durations *relative to median*, not absolute size
    duration_fairness = PARAMS["duration_fairness"] * np.abs(norm_duration)
    
    # Anti-starvation: linear boost per waiting second, capped and normalized
    wait_boost = PARAMS["wait_bias"] * norm_wait
    
    # Work burden term: reduce priority for tasks with large remaining downstream work
    work_term = -PARAMS["work_weight"] * norm_work
    
    # Total priority score: smaller = higher priority
    score = (
        slack_urgency
        + coupling
        + PARAMS["energy_scale"] * norm_energy
        + criticality_term
        + duration_fairness
        - wait_boost
        + work_term
    )
    
    # Final safeguard: replace NaN/inf with finite values, preserve shape
    score = np.nan_to_num(score, nan=0.0, posinf=np.finfo(float).max, neginf=-np.finfo(float).max)
    
    return score

### [Current Version (Recently Generated)]
import numpy as np

# 函数名中的 1 由 SeEvo 在生成 Prompt 时替换为目标版本号。
# 八个输入均为长度 N 的一维数组；相同下标始终指向同一个 ready task。
# 返回值也必须是长度 N 的一维数组，并遵守“分数越小，优先级越高”。
def get_task_priority_v1(
    min_exec_time,
    min_comm_time,
    min_incremental_energy,
    slack,
    upward_rank,
    remaining_work,
    ready_wait_time,
    uncertainty
):

    'Improved priority rule: combines tanh urgency, robust MAD normalization, \n    uncertainty-gated criticality, and starvation-aware fairness.'
    eps = PARAMS['epsilon']
    min_exec_time = np.asarray(min_exec_time, dtype=float)
    min_comm_time = np.asarray(min_comm_time, dtype=float)
    min_incremental_energy = np.asarray(min_incremental_energy, dtype=float)
    slack = np.asarray(slack, dtype=float)
    upward_rank = np.asarray(upward_rank, dtype=float)
    remaining_work = np.asarray(remaining_work, dtype=float)
    ready_wait_time = np.asarray(ready_wait_time, dtype=float)
    uncertainty = np.asarray(uncertainty, dtype=float)
    N = len(min_exec_time)
    def robust_normalize(x):
        x = np.abs(x)
        center = np.median(x)
        scale = np.median(np.abs(x - center)) + eps
        return (x - center) / (scale + eps)
    norm_slack = robust_normalize(slack)
    norm_energy = robust_normalize(min_incremental_energy)
    norm_rank = robust_normalize(upward_rank)
    norm_work = robust_normalize(remaining_work)
    norm_wait = robust_normalize(ready_wait_time)
    norm_uncert = robust_normalize(uncertainty)
    norm_duration = robust_normalize(min_exec_time + min_comm_time)
    slack_urgency = PARAMS['slack_risk_penalty'] * np.tanh(np.clip(-norm_slack, 0, PARAMS['slack_clip_upper'])) + PARAMS['slack_urgency_gain'] * np.tanh(np.clip(norm_slack, 0, PARAMS['slack_clip_upper_pos']))
    slack_pressure = np.clip(-norm_slack, 0, PARAMS['slack_clip_upper'])
    rank_gate = 1.0 / (1.0 + np.exp(PARAMS['rank_slack_gate'] * (slack_pressure - 2)))
    uncert_gate = np.where(norm_uncert > 0.35, 1.0, 0.0)
    criticality_term = PARAMS['criticality_weight'] * rank_gate * norm_rank * (1.0 + 0.5 * norm_uncert * uncert_gate)
    coupling = np.tanh(PARAMS['uncertainty_slack_coupling'] * norm_uncert * slack_pressure)
    duration_fairness = PARAMS['duration_fairness'] * np.abs(norm_duration)
    wait_boost = PARAMS['wait_bias'] * ready_wait_time
    work_term = -PARAMS['work_weight'] * norm_work
    score = slack_urgency + coupling + PARAMS['energy_scale'] * norm_energy + criticality_term + duration_fairness - wait_boost + work_term
    score = np.nan_to_num(score, nan=0.0, posinf=np.finfo(float).max, neginf=-np.finfo(float).max)
    return score.reshape(-1)

### [Self-Reflection on Recent Evolution]
- The second version’s discrete structural change—`np.abs(x)` in `robust_normalize` and hard `np.where` gate on `norm_uncert`—broke monotonicity and introduced non-differentiable discontinuities, harming CMA-ES convergence and feasibility stability.  
- Replacing soft `tanh`-based uncertainty coupling with a brittle binary gate (`uncert_gate`) decoupled uncertainty from slack pressure gradation, worsening deadline adherence under fuzzy risk.  
- `ready_wait_time` used raw (unnormalized) in wait_boost—breaking scale invariance and amplifying starvation bias disproportionately; robust normalization must apply uniformly across all time-domain features.

