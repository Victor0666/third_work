        },
        {
            "name": "slack_penalty_exponent",
            "initial_value": 2.0,
            "lower_bound": 1.0,
            "upper_bound": 4.0,
            "semantic_description": "Exponent for nonlinear penalty on negative slack (risk-aware urgency).",
            "parameter_type": "float",
            "transform": "identity"
        },
        {
            "name": "criticality_boost",
            "initial_value": 1.5,
            "lower_bound": 0.5,
            "upper_bound": 5.0,
            "semantic_description": "Multiplier amplifying priority when upward_rank is above median.",
            "parameter_type": "float",
            "transform": "identity"
        },
        {
            "name": "energy_sensitivity",
            "initial_value": 0.7,
            "lower_bound": 0.1,
            "upper_bound": 3.0,
            "semantic_description": "Weight for normalized incremental energy in feasible region.",
            "parameter_type": "float",
            "transform": "identity"
        },
        {
            "name": "duration_balance",
            "initial_value": 0.6,
            "lower_bound": 0.0,
            "upper_bound": 2.0,
            "semantic_description": "Weight for combined exec+comm time, balanced against criticality.",
            "parameter_type": "float",
            "transform": "identity"
        },
        {
            "name": "wait_decay_rate",
            "initial_value": 0.05,
            "lower_bound": 0.0,
            "upper_bound": 0.5,
            "semantic_description": "Exponential decay coefficient for anti-starvation wait boost.",
            "parameter_type": "float",
            "transform": "identity"
        },
        {
            "name": "uncertainty_slack_coupling",
            "initial_value": 0.8,
            "lower_bound": 0.0,
            "upper_bound": 3.0,
            "semantic_description": "Strength of uncertainty-modulated slack pressure (higher = more risk-averse).",
            "parameter_type": "float",
            "transform": "identity"
        },
        {
            "name": "rank_energy_interaction",
            "initial_value": 0.4,
            "lower_bound": 0.0,
            "upper_bound": 1.5,
            "semantic_description": "Penalty term when high-energy tasks also have high upward rank (avoids costly bottlenecks).",
            "parameter_type": "float",
            "transform": "identity"
        },
        {
            "name": "urgency_clip_max",
            "initial_value": 4.0,
            "lower_bound": 1.0,
            "upper_bound": 6.0,
            "semantic_description": "Upper bound for clipped urgency base to prevent overflow in exp().",
            "parameter_type": "float",
            "transform": "identity"
        }
    ]
}


def get_task_priority_v2(
    min_exec_time,
    min_comm_time,
    min_incremental_energy,
    slack,
    upward_rank,
    remaining_work,
    ready_wait_time,
    uncertainty
):
    """
    Novel priority rule: prioritizes deadline-criticality first via robust slack gating,
    couples uncertainty with slack to amplify risk awareness, uses exponential urgency for negative slack,
    applies conditional criticality boost, and penalizes high-energy + high-rank combinations.
    Anti-starvation uses soft exponential wait boost instead of linear scaling.
    All features are robustly normalized using mean-abs + epsilon; no unbounded ops.
    """
    eps = PARAMS["epsilon"]
    
    # Safe, finite, deterministic normalization: use mean absolute value + epsilon
    def robust_norm(x):
        x = np.asarray(x, dtype=np.float64)
        denom = np.mean(np.abs(x)) + eps
        return x / denom
    
    # Normalize base features
    norm_slack = robust_norm(slack)
    norm_energy = robust_norm(min_incremental_energy)
    norm_duration = robust_norm(min_exec_time + min_comm_time)
    norm_rank = robust_norm(upward_rank)
    norm_wait = robust_norm(ready_wait_time)
    norm_uncert = robust_norm(uncertainty)
    
    # === 1. Risk-urgent slack: exponential penalty for negative slack, bounded smoothness ===
    slack_sign_mask = (slack < 0).astype(float)
    urgency_base = -norm_slack * slack_sign_mask
    # Clamp to avoid overflow: use declared parameter instead of literal
    urgency_clipped = np.clip(urgency_base, 0.0, PARAMS["urgency_clip_max"])
    urgency_penalty = np.exp(PARAMS["slack_penalty_exponent"] * urgency_clipped)
    
    # === 2. Criticality boost: only activate for top-half upward_rank tasks ===
    rank_median = np.median(norm_rank)
    critical_mask = (norm_rank >= rank_median).astype(float)
    critical_boost = PARAMS["criticality_boost"] * norm_rank * critical_mask
    
    # === 3. Uncertainty-modulated slack pressure: stronger penalty when both slack is tight AND uncertainty high ===
    slack_pressure = np.maximum(0.0, -norm_slack)
    uncertainty_coupled_pressure = PARAMS["uncertainty_slack_coupling"] * slack_pressure * norm_uncert
    
    # === 4. Anti-starvation: soft exponential boost for long-waiting tasks (not linear)
    wait_boost = 1.0 - np.exp(-PARAMS["wait_decay_rate"] * norm_wait)
    
    # === 5. Energy-rank interaction penalty: discourage scheduling high-energy tasks that are also on critical path
    rank_energy_penalty = PARAMS["rank_energy_interaction"] * norm_energy * norm_rank
    
    # === Final score: sum of all components — smaller = better ===
    score = (
        urgency_penalty
        + uncertainty_coupled_pressure
        + rank_energy_penalty
        + PARAMS["energy_sensitivity"] * norm_energy
        + PARAMS["duration_balance"] * norm_duration
        - critical_boost
        - wait_boost
    )
    
    # Ensure finite output: replace NaN/inf with safe large finite value
    finfo = np.finfo(np.float64)
    score = np.nan_to_num(score, nan=finfo.max, posinf=finfo.max, neginf=-finfo.max)
    
    return score

### [Performance Analysis]
- Exponential urgency for negative slack (not piecewise linear) better captures risk-aversion under deadline pressure.  
- Criticality boost gated by median upward-rank threshold improves focus on truly bottleneck tasks, reducing noise from low-rank tasks.  
- Rank-energy interaction penalty directly mitigates costly critical-path assignments, aligning energy and deadline objectives more tightly.

