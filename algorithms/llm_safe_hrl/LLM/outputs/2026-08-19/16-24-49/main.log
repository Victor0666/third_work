import numpy as np


PARAMETER_SCHEMA = {
    "schema_version": 1,
    "parameters": [
        {
            "name": "epsilon",
            "initial_value": 1e-6,
            "lower_bound": 1e-9,
            "upper_bound": 1e-3,
            "semantic_description": "Numerical guard for safe division and normalization.",
            "parameter_type": "float",
