        },
        {
            "name": "slack_urgency_gain",
            "initial_value": 2.5,
            "lower_bound": 0.1,
            "upper_bound": 6.0,
            "semantic_description": "Gain applied to normalized positive slack to reward early-completion margin.",
            "parameter_type": "float",
            "transform": "identity"
        },
        {
            "name": "energy_efficiency_weight",
            "initial_value": 1.2,
            "lower_bound": 0.05,
            "upper_bound": 3.0,
            "semantic_description": "Weight for risk-adjusted marginal energy, scaled by duration-aware efficiency.",
            "parameter_type": "float",
            "transform": "identity"
        },
        {
            "name": "critical_path_bonus",
            "initial_value": 0.9,
            "lower_bound": 0.0,
            "upper_bound": 4.0,
            "semantic_description": "Bonus strength for high upward_rank tasks on critical path.",
            "parameter_type": "float",
            "transform": "identity"
        },
        {
            "name": "wait_decay_rate",
            "initial_value": 0.01,
            "lower_bound": 0.0,
            "upper_bound": 0.1,
            "semantic_description": "Exponential decay coefficient for waiting-time priority boost.",
            "parameter_type": "float",
            "transform": "identity"
        },
        {
            "name": "uncertainty_slack_coupling",
            "initial_value": 0.7,
            "lower_bound": 0.0,
            "upper_bound": 2.0,
            "semantic_description": "Strength of interaction between uncertainty and slack pressure.",
            "parameter_type": "float",
            "transform": "identity"
        },
        {
            "name": "duration_efficiency_ratio",
            "initial_value": 0.6,
            "lower_bound": 0.0,
            "upper_bound": 1.5,
            "semantic_description": "Weight balancing exec+comm time against incremental energy per unit work.",
            "parameter_type": "float",
            "transform": "identity"
        },
        {
            "name": "critical_rank_threshold",
            "initial_value": 0.7,
            "lower_bound": 0.5,
            "upper_bound": 0.95,
            "semantic_description": "Percentile threshold to activate critical-path bonus.",
            "parameter_type": "float",
            "transform": "identity"
        },
        {
            "name": "iqr_percentile_low",
            "initial_value": 25.0,
            "lower_bound": 10.0,
            "upper_bound": 40.0,
            "semantic_description": "Lower percentile for IQR-based normalization.",
            "parameter_type": "float",
            "transform": "identity"
        },
        {
            "name": "iqr_percentile_high",
            "initial_value": 75.0,
            "lower_bound": 60.0,
            "upper_bound": 90.0,
            "semantic_description": "Upper percentile for IQR-based normalization.",
            "parameter_type": "float",
            "transform": "identity"
        }
