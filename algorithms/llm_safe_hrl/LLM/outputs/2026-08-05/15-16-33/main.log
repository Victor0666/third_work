            "initial_value": 0.8,
            "lower_bound": 0.0,
            "upper_bound": 2.0,
            "semantic_description": "Modulates how strongly uncertainty amplifies slack-based risk penalty.",
            "parameter_type": "float",
            "transform": "identity"
        },
        {
            "name": "rank_normalization_offset",
            "initial_value": 0.1,
            "lower_bound": 0.0,
            "upper_bound": 0.5,
            "semantic_description": "Small offset to prevent rank dominance when upward_rank is near zero.",
            "parameter_type": "float",
